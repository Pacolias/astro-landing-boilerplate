---
import Layout from '../layouts/Layout.astro';
import { BookingCalendar } from '../components/sections/BookingCalendar';
import * as Lucide from 'lucide-react';
---

<Layout title="Book an Appointment | Generic Business Project" description="Schedule a consultation or appointment with our team.">
  <section class="py-20 bg-slate-50 dark:bg-slate-950 min-h-[calc(100vh-4rem)] transition-colors">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight sm:text-5xl mb-4">
          Schedule Your Consultation
        </h1>
        <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
          Select a suitable time slot below to book a direct one-on-one session with our team.
        </p>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-800 p-8 sm:p-12 transition-colors">
        <div class="flex flex-col md:flex-row gap-8 items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-8 mb-8">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0">
              <Lucide.Calendar className="w-6 h-6" />
            </div>
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white text-lg">Discovery Call</h3>
              <p class="text-sm text-slate-500 dark:text-slate-400">30 minutes • Video Call via Google Meet / Zoom</p>
            </div>
          </div>
          <a 
            href="/" 
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-slate-900 dark:bg-slate-800 hover:bg-slate-800 dark:hover:bg-slate-700 text-white font-bold text-xs uppercase tracking-widest shadow-sm transition-all duration-200"
          >
            <Lucide.ArrowLeft className="w-4 h-4" /> Back to Home
          </a>
        </div>

        <BookingCalendar client:load />
      </div>
    </div>
  </section>
</Layout>